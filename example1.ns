print("Адовий калькулятор");
command = "";
while (command != "exit"){
    command = input("Введіть команду (add, sub, mul, div) або 'exit'");
    if (command == "add") {
        print("Введіть два числа:");
        a = to_float(input());
        b = to_float(input());
        print("Результат: " + to_str(a + b));
    } elif (command == "sub") {
        print("Введіть два числа:");
        a = to_float(input());
        b = to_float(input());
        print("Результат: " + to_str(a - b));
    } elif (command == "mul") {
        print("Введіть два числа:");
        a = to_float(input());
        b = to_float(input());
        print("Результат: " + to_str(a * b));
    } elif (command == "div") {
        print("Введіть два числа:");
        a = to_float(input());
        b = to_float(input());

        if (b != 0) {
            print("Результат: " + to_str(a / b));
        } else {
            print("Помилка: ділення на нуль!");
        }
    } elif (command != "exit") {
        print("Невідома команда. Спробуйте ще раз.");
    }
}
