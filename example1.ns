Aleph = to_int(input("Введи ціле число: "));
if (Aleph<0) { print("Ти дибіл?"); }
if (Aleph % 3 == 0){
    print("Кратне 3.");
}
elif (Aleph % 3 == 1){
    print("Остача - 1");
}
else {
    print("Остача - 2");
}

